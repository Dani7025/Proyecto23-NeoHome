        "filters": {}
      },
      "id": "supa-tasa",
      "name": "Get Tasa BCV",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [450, 300],
      "credentials": {
        "supabaseApi": {
          "id": "PLACEHOLDER",
          "name": "NeoHome Supabase"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $('Webhook').item.json.body.imagen_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "http-img",
      "name": "Descargar Imagen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst binaryData = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst base64String = binaryData.toString('base64');\nreturn [{\n  json: {\n    mimeType: item.binary.data.mimeType || 'image/jpeg',\n    base64: base64String\n  }\n}];"
      },
      "id": "code-b64",
      "name": "Convertir a Base64",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [950, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash:generateContent?key=AIzaSyCqCjj6oHVLftk4ov4dhZyRq6Q-JioB7Ag",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: 'Analiza esta imagen de comprobante de pago venezolano. Extrae monto, fecha y referencia. Devuelve SOLO este JSON sin texto adicional: {\"monto\": 0.00, \"fecha\": \"YYYY-MM-DD\", \"referencia\": \"string\"}' }, { inline_data: { mime_type: $json.mimeType, data: $json.base64 } }] }] }) }}",
        "options": {}
      },
      "id": "http-gemini",
      "name": "Gemini API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 300]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst rawText = item.json.candidates[0].content.parts[0].text;\nlet parsed = null;\ntry {\n  parsed = typeof rawText === 'string' ? JSON.parse(rawText) : rawText;\n} catch (e) {\n  parsed = { monto: null, fecha: null, referencia: null };\n}\nreturn [{\n  json: {\n    comprobante_id: $('Webhook').item.json.body.comprobante_id,\n    unidad_id: $('Webhook').item.json.body.unidad_id,\n    monto_extraido: parsed.monto,\n    fecha_extraida: parsed.fecha,\n    referencia: parsed.referencia,\n    tasa_bcv: parseFloat($('Get Tasa BCV').item.json.valor || '0'),\n    raw_gemini: rawText\n  }\n}];"
      },
      "id": "code-parse",
      "name": "Parsear Gemini",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1450, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1700, 300]
    }
  ],
  "connections": {
